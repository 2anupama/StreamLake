APP_NAME=StreamLake
APP_ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FILE=logs/streamlake.log
ENABLE_FILE_LOGGING=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamlake_source
POSTGRES_DATABASE=streamlake
POSTGRES_USER=streamlake
POSTGRES_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CONNECT_URL=http://localhost:8083
KAFKA_EMPLOYEE_TOPIC=employee_changes
KAFKA_DEPENDENT_TOPIC=dependent_changes
KAFKA_POLICY_TOPIC=policy_changes
KAFKA_COMPANY_TOPIC=company_changes
KAFKA_DEAD_LETTER_TOPIC=employee_dead_letter
CDC_BRONZE_PATH=data/bronze/cdc_v2
CDC_STAGING_PATH=data/staging/cdc_v2
CDC_SILVER_PATH=data/silver/cdc_employee_current_v2.parquet
CDC_QUARANTINE_PATH=data/quarantine/cdc_v2
CDC_CHECKPOINT_PATH=data/checkpoints/cdc_v2
CDC_DUCKDB_PATH=data/streamlake_cdc_v2.duckdb
CDC_MAX_OFFSETS_PER_TRIGGER=1000

DATA_ROOT=data
DUCKDB_PATH=data/streamlake.duckdb
BATCH_CHUNK_SIZE=2000
SOURCE_SYSTEM=local
INGESTION_AUDIT_PATH=logs/ingestion_audit.jsonl

GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=
BIGQUERY_DATASET=streamlake_silver
GOOGLE_APPLICATION_CREDENTIALS=
STORAGE_BACKEND=local
WAREHOUSE_BACKEND=duckdb

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_TO_EMAIL=
SMTP_USE_TLS=true

CDC_STARTING_OFFSETS=earliest
CDC_QUERY_NAME=employee-cdc
