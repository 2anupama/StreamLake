{
  "name": "streamlake-postgres",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "${POSTGRES_USER}",
    "database.password": "${POSTGRES_PASSWORD}",
    "database.dbname": "${POSTGRES_DB}",
    "topic.prefix": "streamlake",
    "plugin.name": "pgoutput",
    "slot.name": "streamlake_cdc",
    "slot.drop.on.stop": "false",
    "publication.name": "streamlake_publication",
    "publication.autocreate.mode": "disabled",
    "snapshot.mode": "initial",
    "table.include.list": "public.companies,public.policies,public.employees,public.dependents",
    "include.schema.changes": "false",
    "provide.transaction.metadata": "true",
    "heartbeat.interval.ms": "10000",
    "errors.max.retries": "-1",
    "tombstones.on.delete": "true",
    "transforms": "routeEmployees,routeDependents,routePolicies,routeCompanies",
    "transforms.routeEmployees.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeEmployees.regex": "streamlake\\.public\\.employees",
    "transforms.routeEmployees.replacement": "employee_changes",
    "transforms.routeDependents.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeDependents.regex": "streamlake\\.public\\.dependents",
    "transforms.routeDependents.replacement": "dependent_changes",
    "transforms.routePolicies.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routePolicies.regex": "streamlake\\.public\\.policies",
    "transforms.routePolicies.replacement": "policy_changes",
    "transforms.routeCompanies.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeCompanies.regex": "streamlake\\.public\\.companies",
    "transforms.routeCompanies.replacement": "company_changes"
  }
}